  "font": {
    "display": {
      "family": "Newsreader",
      "fallback": "Georgia, 'Times New Roman', serif",
      "weights": [
        400,
        500,
        600
      ],
      "opsz": "6–72",
      "use": "Big words, headings, wordmark"
    },
    "mono": {
      "family": "Space Mono",
      "fallback": "ui-monospace, Menlo, monospace",
      "weights": [
        400,
        700
      ],
      "use": "Specs, labels, annotations, code"
    },
    "body": {
      "family": "Inter",
      "fallback": "system-ui, -apple-system, 'Segoe UI', sans-serif",
      "weights": [
        400,
        500,
        600
      ],
      "use": "Docs, UI, running text"
    }
  },
  "type": {
    "display-xl": {
      "font": "display",
      "size": "96px",
      "line": "1.0",
      "weight": 500,
      "tracking": "-0.015em"
    },
    "display-l": {
      "font": "display",
      "size": "64px",
      "line": "1.05",
      "weight": 500,
      "tracking": "-0.01em"
    },
    "display-m": {
      "font": "display",
      "size": "40px",
      "line": "1.1",
      "weight": 500,
      "tracking": "-0.005em"
    },
    "heading": {
      "font": "display",
      "size": "28px",
      "line": "1.2",
      "weight": 500
    },
    "body": {
      "font": "body",
      "size": "16px",
      "line": "1.6",
      "weight": 400
    },
    "small": {
      "font": "body",
      "size": "14px",
      "line": "1.5",
      "weight": 400
    },
    "spec": {
      "font": "mono",
      "size": "12px",
      "line": "1.4",
      "weight": 400,
      "tracking": "0.02em"
    },
    "label": {
      "font": "mono",
      "size": "11px",
      "line": "1.4",
      "weight": 400,
      "tracking": "0.08em",
      "case": "uppercase"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px"
  },
  "radius": {
    "none": "0",
    "note": "Hard edges everywhere. Circles are circles; nothing else is rounded."
  },
  "stroke": {
    "hairline": "1px",
    "construction": "1px dashed (4 4)",
    "emphasis": "2px"
  },
  "motion": {
    "duration": {
      "instant": "120ms",
      "quick": "240ms",
      "base": "400ms",
      "slow": "700ms",
      "ambient": "4800ms"
    },
    "easing": {
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
      "linear": "linear"
    },
    "stagger": "40ms"
  }
}