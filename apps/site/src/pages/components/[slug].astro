---
import Base from "../../layouts/Base.astro";
import { components, github, optionList, swatches, type Component } from "../../lib/components";

export function getStaticPaths() {
  return components.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Component };
const cssFile = `${c.slug}.css`;

const tags = [
  { label: "[ 0 deps ]", color: "--u-ring-lime", tip: "No JavaScript and no packages. Just HTML and CSS you paste into your project." },
  c.state && { label: `state: ${c.state.attr}`, color: "--u-ring-sky", tip: `Your code changes ${c.state.attr} (or data-state) on the element; the CSS animates the change. That attribute is the only thing you wire up.` },
  c.status === "experimental"
    ? { label: "early release", color: "--u-ring-butter", tip: "Ready to use, but names of classes and settings may still change before version 1.0. Pin the version you copy." }
    : { label: "stable", color: "--u-ring-mint", tip: "The markup, classes and settings won't change without a major version." },
  c.support.level === "baseline"
    ? { label: "all modern browsers", color: "--u-ring-iris", tip: "Uses only CSS that Chrome, Safari, Firefox and Edge have all supported for at least 2.5 years (Baseline widely available)." }
    : { label: "experimental CSS", color: "--u-ring-coral", tip: c.support.notes || "Uses new CSS that not every browser supports yet. Elsewhere it changes state without the animation." },
  {
    label: `${c.size.kb} kB · ${c.size.tier}`,
    color: c.size.color,
    tip: `The CSS is ${c.size.bytes} bytes after gzip, which is how browsers download it. Lightweight is under 1 kB, moderate under 2.5 kB, heavy above.`,
  },
].filter(Boolean) as { label: string; color: string; tip: string }[];

const frameworks = [
  { id: "html", label: "HTML" },
  { id: "react", label: "React" },
  { id: "vue", label: "Vue" },
  { id: "svelte", label: "Svelte" },
  { id: "astro", label: "Astro" },
];
---

<Base title={`${c.name} — Uinimate`} description={c.description}>
  <article class="wrap page">
    <a class="back spec" href="/components">← All components</a>

    <header class="head">
      <span class="label">Specimen {c.id} · {c.category}</span>
      <h1 class="display h1">{c.name}</h1>
      <p class="lede">{c.description}</p>
      <ul class="chips" aria-label="About this component">
        {tags.map((t) => (
          <li class="chip tip" tabindex="0" style={`background:var(${t.color})`}>
            {t.label}
            <span class="tip-body" role="tooltip">{t.tip}</span>
          </li>
        ))}
      </ul>
    </header>

    <section class="lab" aria-label="Playground" data-attr={c.state?.attr ?? ""} data-values={JSON.stringify(c.state?.values ?? [])}>
      <div class="stage" id="stage">
        <div class="big" set:html={c.html} />
        <div class="small" aria-hidden="true">
          <span class="spec">1:1</span>
          <div set:html={c.html} />
        </div>
        <span class="spec fig">Fig. 01 — 250 % · click to toggle</span>
      </div>

      <div class="panel">
        {c.state && (
          <div class="row">
            <span class="label">State</span>
            <button class="btn btn--solid toggle" type="button" id="toggle">
              <span>{c.state.attr}=</span><output id="state-val">"{c.state.values[0]}"</output>
            </button>
          </div>
        )}
        {c.variants.length > 1 && (
          <div class="row">
            <span class="label">Variant</span>
            <div class="seg" role="radiogroup" aria-label="Variant" data-variants>
              {c.variants.map((v, i) => (
                <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-variant={i === 0 ? "" : v.name}>{v.label}</button>
              ))}
            </div>
          </div>
        )}
        {c.tunables.map((t) =>
          t.type === "color" ? (
            <div class="row" data-color={t.prop} data-default={t.default}>
              <span class="label">{t.label ?? t.prop} <output data-out={t.prop}>Auto · follows the text colour</output></span>
              <div class="swatches" role="radiogroup" aria-label={t.label ?? t.prop}>
                {swatches.map((s, i) => (
                  <button type="button" role="radio" class:list={["swatch", "tip", !s.hex && "swatch--auto"]} aria-checked={i === 0 ? "true" : "false"}
                    data-value={s.value} data-label={s.hex ? `${s.label} · ${s.hex}` : "Auto · follows the text colour"} aria-label={s.label}
                    style={s.hex ? `--sw:${s.hex}` : undefined}>
                    {!s.hex && "Auto"}
                    <span class="tip-body" role="tooltip">{s.hex ? <>{s.label} <code>{s.hex}</code></> : "Auto: follows the surrounding text colour (currentColor)"}</span>
                  </button>
                ))}
              </div>
              <div class="hex">
                <input type="color" aria-label="Pick a custom colour" value="#89d0ff" data-picker />
                <input type="text" class="hex-input" placeholder="Custom #rrggbb" maxlength="7" spellcheck="false" aria-label="Custom hex colour" data-hex />
              </div>
            </div>
          ) : (
            t.type === "keyword" ? (
              <div class="row" data-keyword={t.prop} data-default={t.default}>
                <span class="label">{t.label ?? t.prop}</span>
                <div class="seg" role="radiogroup" aria-label={t.label ?? t.prop}>
                  {optionList(t).map((o) => (
                    <button type="button" role="radio" aria-checked={o.value === t.default ? "true" : "false"}
                      data-value={o.value} data-note={o.note ?? ""} data-also={JSON.stringify(o.also ?? {})}>{o.label}</button>
                  ))}
                </div>
                <p class="opt-note spec" data-note-out>{optionList(t).find((o) => o.value === t.default)?.note}</p>
              </div>
            ) : (
              <label class="row field">
                <span class="label">{t.label ?? t.prop} <output data-out={t.prop}>{t.default}</output></span>
                <input type="range" data-prop={t.prop} data-default={t.default} data-unit={t.unit ?? ""}
                  min={t.min} max={t.max} step={t.step} value={parseFloat(t.default)} />
              </label>
            )
          ),
        )}
        <button class="reset spec" type="button" id="reset">Reset to defaults</button>
      </div>
    </section>

    <section class="code-wrap" aria-label="Code">
      <div class="tabs" role="tablist" data-ind="line">
        <button role="tab" aria-selected="true" data-tab="html">HTML</button>
        <button role="tab" aria-selected="false" data-tab="css">CSS</button>
        <button role="tab" aria-selected="false" data-tab="npm">npm <span class="soon">soon</span></button>
      </div>
      <div class="code">
        <pre data-pane="html" class="pane"><code id="code-html">{c.html.trim()}</code></pre>
        <pre data-pane="css" class="pane" hidden><code>{c.css.trim()}</code></pre>
        <div data-pane="npm" hidden class="pane npm">
          <p class="npm-note"><strong>Coming soon.</strong> The <code>uinimate</code> package isn't on npm yet. Copy the HTML and CSS for now; this is how it will work:</p>
          <pre><code>{`npm i uinimate\n\n// once, in your app's entry or main stylesheet\nimport "uinimate/components/${c.slug}/${cssFile}";`}</code></pre>
        </div>
        <button class="btn btn--solid copy" type="button" id="copy">Copy</button>
      </div>
    </section>

    <section class="guide" aria-labelledby="guide-title">
      <div class="guide-head">
        <span class="label">Use it in your project</span>
        <h2 id="guide-title" class="display h2">Three steps, no install.</h2>
      </div>
      <ol class="steps">
        <li>
          <span class="spec step-no">01</span>
          <h3>Add the CSS</h3>
          <p>Copy the <strong>CSS</strong> tab into your stylesheet, or save it as <code>{cssFile}</code> and link it. It works on its own; our design tokens are optional.</p>
        </li>
        <li>
          <span class="spec step-no">02</span>
          <h3>Paste the markup</h3>
          <p>Copy the <strong>HTML</strong> tab where the {c.name.toLowerCase()} should go. Your playground choices (variant, size, colour…) are already in it.</p>
        </li>
        {c.state && (
          <li>
            <span class="spec step-no">03</span>
            <h3>Flip the state</h3>
            <p>Set <code>{c.state.attr}</code> to <code>"{c.state.values[1]}"</code> or <code>"{c.state.values[0]}"</code> from your code. That's the whole wiring. Pick your framework below.</p>
          </li>
        )}
      </ol>

      <div class="fw">
        <div class="seg fw-seg" role="tablist" aria-label="Framework">
          {frameworks.map((f, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-fw={f.id}>{f.label}</button>
          ))}
        </div>
        <div class="code">
          <pre class="pane"><code id="code-fw"></code></pre>
          <button class="btn btn--solid copy" type="button" id="copy-fw">Copy</button>
        </div>
      </div>

      <aside class="labnote" aria-label="Tip">
        <span class="labnote-mark" aria-hidden="true"></span>
        <div>
          <span class="label">Lab note · tip</span>
          <p>Every setting is a CSS variable, so you can tune the {c.name.toLowerCase()} from <em>any</em> parent. One line changes every {c.name.toLowerCase()} in your header:</p>
          <pre><code>{`.site-header {
  --u-${c.slug}-duration: 500ms;
  --u-icon-stroke: 1.5;
}`}</code></pre>
        </div>
      </aside>
    </section>

    <section class="notes">
      <div>
        <span class="label">Accessibility</span>
        <p>{c.a11y}</p>
      </div>
      <div>
        <span class="label">Source</span>
        <p><a href={`${github}/tree/main/packages/core/src/components/${c.slug}`}>packages/core/src/components/{c.slug}</a></p>
      </div>
    </section>
  </article>
</Base>

<script>
  const lab = document.querySelector<HTMLElement>(".lab")!;
  const stage = document.getElementById("stage")!;
  const attr = lab.dataset.attr || "";
  const values: string[] = JSON.parse(lab.dataset.values || "[]");
  const hosts = () => [...stage.querySelectorAll<HTMLElement>(".big > *, .small > div > *")];
  const codeHtml = document.getElementById("code-html")!;
  const codeFw = document.getElementById("code-fw")!;
  const pristine = codeHtml.textContent || "";
  const cls = pristine.match(/class="([^"\s]+)/)?.[1] ?? "component";
  const cssFile = `${cls.replace(/^u-/, "")}.css`;
  hosts().forEach((h, i) => i > 0 && h.setAttribute("tabindex", "-1"));

  const vars: Record<string, string> = {};
  let variant = "";
  let fw = "html";

  // ---------- code generation ----------
  function markup() {
    const style = Object.entries(vars).map(([k, v]) => `${k}: ${v}`).join("; ");
    const open = pristine.indexOf(">");
    const extra = (variant ? ` data-variant="${variant}"` : "") + (style ? ` style="${style}"` : "");
    return extra ? pristine.slice(0, open) + extra + pristine.slice(open) : pristine;
  }
  const indent = (s: string, n: number) => s.split("\n").map((l) => (l ? " ".repeat(n) + l : l)).join("\n");
  function toJsx(html: string) {
    let out = html.replace(/\sclass="/g, ' className="');
    out = out.replace(/\sstyle="([^"]*)"/, (_, s: string) => {
      const pairs = s.split(";").map((p) => p.trim()).filter(Boolean).map((p) => {
        const [k, ...v] = p.split(":");
        return `"${k.trim()}": "${v.join(":").trim()}"`;
      });
      return ` style={{ ${pairs.join(", ")} }}`;
    });
    return out;
  }
  function frameworkCode() {
    const html = markup();
    const on = values[1], off = values[0];
    const bound = (expr: string) => (attr ? html.replace(`${attr}="${off}"`, expr) : html);
    const twoWay = values.length === 2 && on === "true" && off === "false";
    switch (fw) {
      case "react": {
        const jsx = toJsx(attr ? bound(twoWay ? `${attr}={on} onClick={() => setOn(!on)}` : `${attr}={on ? "${on}" : "${off}"} onClick={() => setOn(!on)}`) : html);
        return `import { useState } from "react";\nimport "./${cssFile}";\n\nexport function ${cls.replace(/^u-/, "").replace(/(^|-)(\w)/g, (_, __, ch) => ch.toUpperCase())}() {\n  const [on, setOn] = useState(false);\n  return (\n${indent(jsx, 4)}\n  );\n}`;
      }
      case "vue": {
        const tpl = attr ? bound(twoWay ? `:${attr}="on" @click="on = !on"` : `:${attr}="on ? '${on}' : '${off}'" @click="on = !on"`) : html;
        return `<script setup>\nimport { ref } from "vue";\nimport "./${cssFile}";\nconst on = ref(false);\n<\/script>\n\n<template>\n${indent(tpl, 2)}\n</template>`;
      }
      case "svelte": {
        const tpl = attr ? bound(twoWay ? `${attr}={on} onclick={() => (on = !on)}` : `${attr}={on ? "${on}" : "${off}"} onclick={() => (on = !on)}`) : html;
        return `<script>\n  import "./${cssFile}";\n  let on = $state(false);\n<\/script>\n\n${tpl}`;
      }
      case "astro":
      case "html": {
        const head = fw === "astro" ? `---\nimport "./${cssFile}";\n---\n\n` : `<link rel="stylesheet" href="${cssFile}" />\n\n`;
        if (!attr) return head + html;
        const script = `<script>\n  document.querySelectorAll(".${cls}").forEach((el) => {\n    el.addEventListener("click", () => {\n      const on = el.getAttribute("${attr}") === "${on}";\n      el.setAttribute("${attr}", on ? "${off}" : "${on}");\n    });\n  });\n<\/script>`;
        return head + html + "\n\n" + script;
      }
    }
    return html;
  }
  const codeBox = codeHtml.closest(".code") as HTMLElement;
  function sizePanes() {
    const pre = codeHtml.parentElement as HTMLElement;
    if (pre.hidden) return;
    const prev = pre.style.height;
    pre.style.height = "auto";
    codeBox.style.setProperty("--pane-h", `${Math.max(pre.offsetHeight, 220)}px`);
    pre.style.height = prev;
  }
  function render() {
    Object.entries(vars).forEach(([k, v]) => stage.style.setProperty(k, v));
    hosts().forEach((h) => (variant ? h.setAttribute("data-variant", variant) : h.removeAttribute("data-variant")));
    codeHtml.textContent = markup();
    codeFw.textContent = frameworkCode();
    sizePanes();
  }
  function setVar(prop: string, value: string, def: string) {
    stage.style.removeProperty(prop);
    if (value === def) delete vars[prop];
    else vars[prop] = value;
    render();
  }

  // ---------- state ----------
  const out = document.getElementById("state-val");
  function flip() {
    if (!attr || values.length < 2) return;
    const next = hosts()[0].getAttribute(attr) === values[1] ? values[0] : values[1];
    hosts().forEach((h) => h.setAttribute(attr, next));
    if (out) out.textContent = `"${next}"`;
  }
  document.getElementById("toggle")?.addEventListener("click", flip);
  stage.addEventListener("click", flip);

  // ---------- variants ----------
  document.querySelectorAll<HTMLButtonElement>("[data-variants] button").forEach((b, _, all) =>
    b.addEventListener("click", () => {
      all.forEach((x) => x.setAttribute("aria-checked", String(x === b)));
      variant = b.dataset.variant || "";
      moveIndicator(b.parentElement!);
      render();
    }),
  );

  // ---------- sliders and selects ----------
  const controls = [...document.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-prop]")];
  controls.forEach((el) =>
    el.addEventListener("input", () => {
      const prop = el.dataset.prop!;
      const value = el instanceof HTMLSelectElement ? el.value : `${el.value}${el.dataset.unit || ""}`;
      const o = document.querySelector(`[data-out="${prop}"]`);
      if (o) o.textContent = el instanceof HTMLSelectElement ? el.selectedOptions[0].text : value;
      setVar(prop, value, el.dataset.default!);
    }),
  );

  // ---------- colour ----------
  document.querySelectorAll<HTMLElement>("[data-color]").forEach((row) => {
    const prop = row.dataset.color!, def = row.dataset.default!;
    const out = row.querySelector("output")!;
    const sws = [...row.querySelectorAll<HTMLButtonElement>(".swatch")];
    const hex = row.querySelector<HTMLInputElement>("[data-hex]")!;
    const picker = row.querySelector<HTMLInputElement>("[data-picker]")!;
    const choose = (value: string, label: string, from?: HTMLButtonElement) => {
      sws.forEach((s) => s.setAttribute("aria-checked", String(s === from)));
      out.textContent = label;
      setVar(prop, value, def);
    };
    sws.forEach((s) => s.addEventListener("click", () => { hex.value = ""; choose(s.dataset.value!, s.dataset.label!, s); }));
    const custom = (v: string) => {
      const ok = /^#[0-9a-f]{6}$/i.test(v);
      hex.setAttribute("aria-invalid", String(!ok && v.length > 0));
      if (ok) choose(v.toLowerCase(), `Custom · ${v.toLowerCase()}`);
    };
    hex.addEventListener("input", () => custom(hex.value.startsWith("#") ? hex.value : `#${hex.value}`));
    picker.addEventListener("input", () => { hex.value = picker.value; custom(picker.value); });
    row.dataset.reset = "1";
    (row as any).reset = () => { hex.value = ""; choose(def, sws[0].dataset.label!, sws[0]); };
  });

  // ---------- keyword options (segmented), which may also set related props ----------
  document.querySelectorAll<HTMLElement>("[data-keyword]").forEach((row) => {
    const prop = row.dataset.keyword!, def = row.dataset.default!;
    const opts = [...row.querySelectorAll<HTMLButtonElement>("[data-value]")];
    const note = row.querySelector("[data-note-out]")!;
    const defAlso: Record<string, string> = JSON.parse(opts.find((o) => o.dataset.value === def)?.dataset.also || "{}");
    const pick = (b: HTMLButtonElement) => {
      opts.forEach((o) => o.setAttribute("aria-checked", String(o === b)));
      note.textContent = b.dataset.note || "";
      setVar(prop, b.dataset.value!, def);
      const also: Record<string, string> = JSON.parse(b.dataset.also || "{}");
      Object.entries(also).forEach(([k, v]) => setVar(k, v, defAlso[k] ?? ""));
      moveIndicator(row.querySelector(".seg")!);
    };
    opts.forEach((b) => b.addEventListener("click", () => pick(b)));
    (row as any).reset = () => pick(opts.find((o) => o.dataset.value === def) ?? opts[0]);
  });

  document.getElementById("reset")?.addEventListener("click", () => {
    controls.forEach((el) => {
      const d = el.dataset.default!;
      el.value = el instanceof HTMLSelectElement ? d : String(parseFloat(d));
      el.dispatchEvent(new Event("input"));
    });
    document.querySelectorAll<any>("[data-color], [data-keyword]").forEach((row) => row.reset?.());
  });

  // ---------- tabs and copy ----------
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tab]")];
  tabs.forEach((t) =>
    t.addEventListener("click", () => {
      tabs.forEach((x) => x.setAttribute("aria-selected", String(x === t)));
      document.querySelectorAll<HTMLElement>("[data-pane]").forEach((p) => (p.hidden = p.dataset.pane !== t.dataset.tab));
    }),
  );
  const fws = [...document.querySelectorAll<HTMLButtonElement>("[data-fw]")];
  fws.forEach((b) =>
    b.addEventListener("click", () => {
      fws.forEach((x) => x.setAttribute("aria-selected", String(x === b)));
      fw = b.dataset.fw!;
      moveIndicator(b.parentElement!);
      render();
    }),
  );
  function copyFrom(btn: HTMLButtonElement, text: () => string) {
    btn.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(text()); btn.textContent = "Copied"; }
      catch { btn.textContent = "Select and copy"; }
      setTimeout(() => (btn.textContent = "Copy"), 1600);
    });
  }
  copyFrom(document.getElementById("copy") as HTMLButtonElement, () => {
    const pane = document.querySelector<HTMLElement>("[data-pane]:not([hidden])");
    return (pane?.querySelector("pre") ?? pane)?.textContent ?? "";
  });
  copyFrom(document.getElementById("copy-fw") as HTMLButtonElement, () => codeFw.textContent ?? "");
  render();

  // ---------- sliding indicator for segmented controls and tabs ----------
  function moveIndicator(group: HTMLElement) {
    const ind = group.querySelector<HTMLElement>(":scope > .ind");
    const active = group.querySelector<HTMLElement>(':scope > [aria-checked="true"], :scope > [aria-selected="true"]');
    if (!ind || !active) return;
    ind.style.transform = `translateX(${active.offsetLeft}px) scaleX(${active.offsetWidth / 100})`;
  }
  document.querySelectorAll<HTMLElement>(".seg").forEach((group) => {
    const ind = document.createElement("span");
    ind.className = "ind";
    ind.setAttribute("aria-hidden", "true");
    group.prepend(ind);
    group.classList.add("has-ind");
    moveIndicator(group);
    requestAnimationFrame(() => requestAnimationFrame(() => group.classList.add("ind-ready")));
    new ResizeObserver(() => moveIndicator(group)).observe(group);
  });
</script>

<style>
  .page { padding-block: 48px 0; display: flex; flex-direction: column; gap: 40px; }
  .back { text-decoration: none; color: var(--muted); }
  .back:hover { color: var(--fg); }
  .head { display: flex; flex-direction: column; gap: 14px; }
  .h1 { font-size: clamp(48px, 7vw, 96px); }
  .h2 { font-size: clamp(32px, 4vw, 48px); }
  .lede { font-size: 18px; color: var(--muted); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  code { font: 0.92em var(--mono); }

  .lab { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); border: 1.5px solid var(--fg); }
  .stage {
    position: relative; min-height: 460px; display: grid; place-items: center; cursor: pointer;
    color: var(--u-chalk); background: var(--u-blueprint) url(/brand/patterns/blueprint-grid.svg);
    border-right: 1.5px solid var(--fg);
  }
  .big { scale: 2.5; display: grid; place-items: center; }
  .small { position: absolute; right: 14px; top: 12px; display: flex; align-items: center; gap: 8px; color: var(--u-chalk); }
  .small .spec, .fig { color: var(--u-chalk-muted); }
  .fig { position: absolute; left: 14px; bottom: 12px; }

  .panel { display: flex; flex-direction: column; gap: 18px; padding: 24px; background: var(--surface); min-width: 0; }
  .row { display: flex; flex-direction: column; gap: 8px; }
  .row output { color: var(--fg); margin-left: 6px; text-transform: none; letter-spacing: 0; }
  .toggle { font: 13px var(--mono); justify-content: center; }
  .toggle output { color: inherit; margin: 0; }
  .seg { position: relative; display: flex; border: 1.5px solid var(--fg); background: var(--bg); isolation: isolate; }
  .seg button { position: relative; flex: 1; font: 13px var(--mono); padding: 9px 8px; border: 0; border-right: 1px solid var(--line); background: none; color: var(--fg); cursor: pointer; transition: color var(--u-dur-quick) var(--u-ease-out); }
  .seg button:last-of-type { border-right: 0; }
  .seg button:hover { background: color-mix(in oklch, var(--fg) 6%, transparent); }
  .seg button[aria-checked="true"], .seg button[aria-selected="true"] { color: var(--bg); background: none; }
  .seg:not(.has-ind) button[aria-checked="true"], .seg:not(.has-ind) button[aria-selected="true"] { background: var(--fg); }
  /* sliding indicator: a 100px block moved and scaled to the active button (transform only) */
  :global(.ind) { position: absolute; left: 0; top: 0; bottom: 0; width: 100px; transform-origin: 0 0; z-index: -1; pointer-events: none; background: var(--fg); }
  /* ease-out, no spring: the indicator must never overshoot past the control's border */
