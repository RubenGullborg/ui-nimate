---
import Base from "../layouts/Base.astro";
const github = "https://github.com/RubenGullborg/ui-nimate";
---

<Base title="Components — Uinimate" description="Animated UI components in pure CSS and SVG. The collection is just getting started.">
  <section class="wrap page">
    <div class="head">
      <span class="label">Components</span>
      <h1 class="display h1">The collection</h1>
      <p class="lede">Each component is a specimen: numbered, measured and tunable with CSS variables. More are on the bench.</p>
    </div>

    <ul class="grid">
      <li class="card">
        <div class="stage">
          <span class="u-morph" role="img" aria-label="Morphing shape"></span>
        </div>
        <div class="meta">
          <span class="spec">Specimen U-001</span>
          <h2>Morph</h2>
          <p>One shape morphs from square to triangle to hexagon to circle. A loader with character.</p>
          <a class="spec link" href={`${github}/tree/main/packages/core/src/specimens/u-001-morph`}>View the CSS →</a>
        </div>
      </li>
      <li class="card card--soon" aria-label="More components coming soon">
        <div class="stage stage--soon">
          <span class="spec">[ in the lab ]</span>
        </div>
        <div class="meta">
          <span class="spec">Specimen U-002</span>
          <h2>Coming soon</h2>
          <p>Follow the repo to see new components as they land.</p>
        </div>
      </li>
    </ul>
  </section>
</Base>

<style>
  .page { padding-block: 72px 0; display: flex; flex-direction: column; gap: 48px; }
  .head { display: flex; flex-direction: column; gap: 14px; }
  .h1 { font-size: clamp(44px, 6vw, 80px); }
  .lede { font-size: 18px; color: var(--muted); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 24px; }
  .card { border: 1.5px solid var(--fg); display: flex; flex-direction: column; background: var(--bg); }
  .stage { aspect-ratio: 4 / 3; display: grid; place-items: center; background: var(--u-blueprint) url(/brand/patterns/blueprint-grid.svg); border-bottom: 1.5px solid var(--fg); }
  .stage--soon { background: var(--surface); color: var(--muted); }
  .meta { display: flex; flex-direction: column; gap: 8px; padding: 20px; }
  .meta .spec { color: var(--muted); }
  .meta h2 { margin: 0; font: 500 30px/1.1 var(--display); }
  .meta p { color: var(--muted); font-size: 15px; }
  .link { margin-top: 6px; color: var(--fg) !important; }
  .card--soon { border-style: dashed; }
</style>
