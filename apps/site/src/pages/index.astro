---
import Base from "../layouts/Base.astro";

const github = "https://github.com/RubenGullborg/ui-nimate";
const values = [
  { shape: "circle", color: "var(--u-ring-sky)", note: "[ 0 deps ]", title: "Zero dependencies", text: "Pure CSS and SVG. Nothing to install and nothing that breaks on updates." },
  { shape: "square", color: "var(--u-ring-lime)", note: "[ ∀ stacks ]", title: "Works everywhere", text: "React, Vue, Svelte, Astro, plain HTML, Webflow, Shopify. If it renders HTML, it runs." },
  { shape: "triangle", color: "var(--u-ring-coral)", note: "[ ƒ(t) tunable ]", title: "Make it yours", text: "Speed, easing, colour and size are CSS variables. Tune, then copy." },
  { shape: "hexagon", color: "var(--u-ring-lilac)", note: "[ reduced motion ]", title: "Motion with manners", text: "Respects reduced-motion settings and never shifts your layout." },
  { shape: "pentagon", color: "var(--u-ring-butter)", note: "[ φ 1.618 ]", title: "Craft over quantity", text: "Fewer, better components. Each one measured, named and documented." },
];
---

<Base>
  <!-- Hero: one big line inside the shape field -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="field">
      <div class="hero-copy">
        <span class="label">Animated UI components · CSS + SVG</span>
        <h1 id="hero-title" class="display hero-title">A laboratory of animated UI&nbsp;components.</h1>
        <p class="lede">Copy-paste animations for any stack. No dependencies.</p>
        <div class="ctas">
          <a class="btn btn--solid" href="/components">Browse components</a>
          <a class="btn btn--ghost" href={github}>Star on GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <!-- The brand film -->
  <section class="wrap film-wrap" aria-label="Brand film">
    <figure class="film">
      <video
        id="film"
        src="/brand/film/uinimate-film-loop.mp4"
        poster="/brand/film/poster.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="Uinimate brand film: shapes and words animate in a laboratory of motion"></video>
      <figcaption class="film-bar">
        <span class="spec">Fig. 00 — A laboratory of motion</span>
        <button id="sound" class="sound spec" type="button" aria-pressed="false">Sound off</button>
      </figcaption>
    </figure>
  </section>

  <!-- Principles -->
  <section class="wrap principles" aria-labelledby="principles-title">
    <svg class="spiral" viewBox="0 0 520 322" aria-hidden="true" fill="none" stroke="currentColor">
      <rect x="0.5" y="0.5" width="519" height="321" stroke-width="1" />
      <path d="M321 0.5 V321.5 M321 199 H519.5 M444 199 V321.5 M367 199 V246 H444 M367 222 H397" stroke-width="1" stroke-dasharray="4 5" />
      <path d="M0.5 321.5 A321 321 0 0 1 321.5 0.5 A199 199 0 0 1 519.5 199 A123 123 0 0 1 397 321.5 A77 77 0 0 1 321 246 A47 47 0 0 1 367 199" stroke-width="2" />
    </svg>
    <div class="principles-head">
      <span class="label">Principles</span>
      <h2 id="principles-title" class="display h2">Motion for any stack.</h2>
    </div>
    <ol class="values">
      {values.map((v, i) => (
        <li class="value">
          <div class="value-top">
            <span class={`shape shape--${v.shape} value-shape`} style={`background:${v.color}`} aria-hidden="true"></span>
            <span class="spec value-fig">Fig. {String(i + 1).padStart(2, "0")}</span>
          </div>
          <h3>{v.title}</h3>
          <p>{v.text}</p>
          <span class="spec value-note">{v.note}</span>
        </li>
      ))}
    </ol>
  </section>
</Base>

<script>
  const film = document.getElementById("film") as HTMLVideoElement | null;
  const sound = document.getElementById("sound") as HTMLButtonElement | null;
  if (film && sound) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) film.pause();
    sound.addEventListener("click", () => {
      film.muted = !film.muted;
      if (!film.muted) film.play().catch(() => {});
      sound.textContent = film.muted ? "Sound off" : "Sound on";
      sound.setAttribute("aria-pressed", String(!film.muted));
    });
  }
</script>

<style>
  /* hero */
  .hero { --field: url(/brand/patterns/shape-field-paper.svg); border-bottom: 1px solid var(--line); }
  :global([data-theme="dark"]) .hero { --field: url(/brand/patterns/shape-field-blueprint.svg); }
  .field {
    min-height: min(78vh, 760px);
    display: grid; place-items: center;
    background: var(--bg) var(--field) center / cover no-repeat;
    padding: 72px 20px;
  }
  .hero-copy {
    display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center;
    max-width: 820px; padding: 36px 40px; background: var(--bg);
  }
  .hero-title { font-size: clamp(42px, 6.4vw, 88px); }
  .lede { font-size: 19px; color: var(--muted); }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 6px; }

  /* film */
  .film-wrap { padding-block: 96px 0; }
  .film { margin: 0; border: 1.5px solid var(--fg); background: var(--u-blueprint); }
  .film video { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .film-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 14px; border-top: 1.5px solid var(--fg); background: var(--surface); }
  .sound { background: var(--u-ring-butter); color: var(--u-ink); border: 0; padding: 6px 12px; cursor: pointer; white-space: nowrap; }
  .sound[aria-pressed="true"] { background: var(--u-ring-lime); }

  /* principles */
  .principles { position: relative; padding-block: 120px 0; display: flex; flex-direction: column; gap: 40px; }
  .spiral { position: absolute; right: 20px; top: 70px; width: min(46%, 520px); color: var(--art); opacity: 0.14; pointer-events: none; }
  .principles-head { position: relative; display: flex; flex-direction: column; gap: 10px; }
  .h2 { font-size: clamp(36px, 5vw, 64px); }
  .values {
    position: relative; list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1.5px solid var(--fg); background: var(--bg);
  }
  .value { display: flex; flex-direction: column; gap: 12px; padding: 24px 22px 22px; border-right: 1px solid var(--line); }
  .value:last-child { border-right: 0; }
  .value-top { display: flex; justify-content: space-between; align-items: flex-start; }
  .value-shape { width: 40px; height: 40px; }
  .value-fig { color: var(--muted); }
  .value h3 { margin: 6px 0 0; font: 500 24px/1.12 var(--display); font-variation-settings: "opsz" 36; }
  .value p { font-size: 15px; color: var(--muted); }
  .value-note { margin-top: auto; padding-top: 10px; border-top: 1px dashed var(--line); color: var(--muted); }

  @media (max-width: 1000px) {
    .values { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .value { border-bottom: 1px solid var(--line); }
    .value:nth-child(2n) { border-right: 0; }
  }
  @media (max-width: 720px) {
    .field { min-height: 560px; padding: 48px 16px; }
    .hero-copy { padding: 28px 20px; }
    .film-wrap { padding-top: 56px; }
    .principles { padding-top: 80px; }
    .values { grid-template-columns: minmax(0, 1fr); }
    .value { border-right: 0; }
    .spiral { width: 80%; top: 40px; }
  }
</style>
