---
import Logo from "./Logo.astro";
import burgerSource from "../../../../packages/core/src/components/burger/burger.html?raw";
// Dogfooding: the header uses the library's own Burger markup.
const burger = burgerSource
  .replace('class="u-burger"', 'class="u-burger menu-btn"')
  .replace('aria-controls="menu"', 'aria-controls="site-nav"');
const github = "https://github.com/RubenGullborg/ui-nimate";
---

<header class="top">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Uinimate home">
      <span class="brand-full"><Logo size="40px" /></span>
      <img class="brand-icon" src="/brand/icon/uinimate-icon.svg" alt="" width="40" height="40" />
    </a>

    <Fragment set:html={burger} />

    <nav id="site-nav" class="nav" aria-label="Main">
      <a class="nav-link" href="/components">Components</a>
      <button class="theme" type="button" aria-pressed="false" title="Switch to blueprint (dark) mode">
        <span class="theme-dot" aria-hidden="true"></span>
        <span class="theme-text">Blueprint</span>
      </button>
      <a class="gh" href={github} aria-label="Uinimate on GitHub" title="GitHub">
        <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span class="gh-text">GitHub</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const theme = document.querySelector<HTMLButtonElement>(".theme");
  const sync = () => {
    const dark = root.dataset.theme === "dark";
    theme?.setAttribute("aria-pressed", String(dark));
    theme?.setAttribute("title", dark ? "Switch to paper (light) mode" : "Switch to blueprint (dark) mode");
    const text = theme?.querySelector(".theme-text");
    if (text) text.textContent = dark ? "Paper" : "Blueprint";
  };
  theme?.addEventListener("click", () => {
    const dark = root.dataset.theme !== "dark";
    if (dark) root.dataset.theme = "dark";
    else delete root.dataset.theme;
    try { localStorage.setItem("uinimate-theme", dark ? "dark" : "light"); } catch {}
    sync();
  });
  sync();

  const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const nav = document.getElementById("site-nav");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") !== "true";
    btn.setAttribute("aria-expanded", String(open));
    nav?.classList.toggle("is-open", open);
  });
</script>

<style>
  .top { position: relative; z-index: 20; border-bottom: 1px solid var(--line); background: var(--bg); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 76px; }
  .brand { display: inline-flex; align-items: center; text-decoration: none; }
  .brand-icon { display: none; }

  .nav { display: flex; align-items: center; gap: 28px; font: 14px var(--mono); }
  .nav-link { text-decoration: none; }
  .nav-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .gh { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
  .gh-text { display: none; }

  .theme { display: inline-flex; align-items: center; gap: 8px; font: 13px var(--mono); color: var(--fg); background: none; border: 1px solid var(--line); padding: 6px 10px; cursor: pointer; }
  .theme:hover { border-color: var(--fg); }
  .theme-dot { width: 12px; height: 12px; background: var(--u-blueprint); border: 1px solid var(--fg); }
  .theme[aria-pressed="true"] .theme-dot { background: var(--u-paper); }

  :global(.menu-btn) { display: none; border: 1px solid var(--line); width: 44px; height: 44px; }

  @media (max-width: 720px) {
    .brand-full { display: none; }
    .brand-icon { display: block; }
    :global(.menu-btn) { display: grid; }
    .nav {
      display: none; position: absolute; inset: 100% 0 auto 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--bg); border-bottom: 1px solid var(--line);
      padding: 8px max(20px, env(safe-area-inset-left, 0px)) 20px;
      font-size: 16px;
    }
    .nav.is-open { display: flex; }
    .nav > * { padding-block: 14px; border-top: 1px solid var(--line); }
    .theme { border: 0; border-top: 1px solid var(--line); padding-inline: 0; font-size: 16px; justify-content: flex-start; }
    .gh-text { display: inline; }
  }
</style>
