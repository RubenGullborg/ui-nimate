---
// The living-i wordmark. Styles come from brand/logo/uinimate-logo.css (imported in site.css).
interface Props {
  size?: string;
  blueprint?: boolean;
  still?: boolean;
}
const { size = "40px", blueprint = false, still = false } = Astro.props;
const classes = ["u-logo", blueprint ? "u-logo--blueprint" : "u-logo--theme", still && "u-logo--still"].filter(Boolean).join(" ");
---

<span class={classes} style={`font-size:${size}`} role="img" aria-label="Uinimate">
  <span class="u-logo__word" aria-hidden="true">U<span class="u-logo__i">ı<i></i></span>n<span class="u-logo__i u-logo__i--2">ı<i></i></span>mate</span>
  <span class="u-logo__base" aria-hidden="true"></span>
</span>
