---
import Logo from "./Logo.astro";
const github = "https://github.com/RubenGullborg/ui-nimate";
const year = new Date().getFullYear();

// A row of ring-coloured primitives along the footer's top edge (decorative, hard-edged).
const ring = ["#89d0ff", "#ffafa1", "#98daa5", "#d1b9ff", "#e0c579", "#71d9eb", "#feacc5", "#bfd186", "#aec5ff", "#f8b884", "#77ddca", "#edb0e6"];
const kinds = ["square", "circle", "triangle", "hexagon", "pentagon", "rect", "circle", "square", "hexagon", "triangle", "rect", "pentagon"];
const field = Array.from({ length: 18 }, (_, i) => {
  const kind = kinds[i % kinds.length];
  const size = [56, 34, 72, 44, 28, 64][i % 6];
  return { kind, color: ring[(i * 5) % ring.length], size, left: (i / 18) * 100 + ((i * 37) % 5), top: [8, 46, 22, 60, 0, 34][i % 6] };
});
---

<footer class="foot">
  <div class="field" aria-hidden="true">
    {field.map((s) => (
      <span
        class:list={["shape", `shape--${s.kind === "rect" ? "square" : s.kind}`]}
        style={`left:${s.left}%;top:${s.top}px;width:${s.kind === "rect" ? s.size * 2 : s.size}px;height:${s.kind === "rect" ? s.size * 0.55 : s.size}px;background:${s.color}`}
      ></span>
    ))}
  </div>

  <div class="wrap inner">
    <div class="lockup">
      <Logo size="clamp(64px, 11vw, 132px)" blueprint />
      <p class="tag display">Motion for any stack.<br />No dependencies.</p>
    </div>

    <div class="cols">
      <div class="col">
        <span class="label">Library</span>
        <a href="/components">Components</a>
        <a href="/agents">Use with AI agents</a>
        <a href={github}>GitHub</a>
      </div>
      <div class="col">
        <span class="label">Studio</span>
        <a href="/brand/brand-guide.html">Brand guide</a>
      </div>
      <div class="col notes" aria-hidden="true">
        <span class="label">Lab notes</span>
        <span class="spec">[ 0 deps ]</span>
        <span class="spec">[ ∆t = 240ms ]</span>
        <span class="spec">[ φ 1.618 ]</span>
      </div>
    </div>

    <div class="base">
      <span class="spec">© {year} Uinimate</span>
      <span class="spec">Specimen U-000 · a laboratory of motion</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative; overflow: hidden;
    background: var(--u-blueprint) url(/brand/patterns/blueprint-grid.svg);
    color: var(--u-chalk);
    margin-top: 120px;
  }
  .field { position: relative; height: 140px; border-bottom: 1px solid color-mix(in oklch, var(--u-chalk) 22%, transparent); }
  .field .shape { position: absolute; }
  .inner { display: flex; flex-direction: column; gap: 64px; padding-block: 72px 36px; }
  .lockup { display: flex; flex-direction: column; align-items: flex-start; gap: 28px; }
  .tag { font-size: clamp(32px, 5vw, 60px); color: var(--u-chalk); }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; border-top: 1px solid color-mix(in oklch, var(--u-chalk) 22%, transparent); padding-top: 28px; }
  .col { display: flex; flex-direction: column; gap: 10px; }
  .col .label { color: var(--u-chalk-muted); margin-bottom: 4px; }
  .col a { color: var(--u-chalk); text-decoration: none; font-size: 17px; }
  .col a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .notes .spec { color: var(--u-chalk-muted); }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; color: var(--u-chalk-muted); }
  @media (max-width: 720px) {
    .cols { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .notes { display: none; }
    .field { height: 110px; }
    .field .shape:nth-child(2n) { display: none; }
  }
</style>
